NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://taskflow:replace_me@127.0.0.1:3306/taskflow
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=replace_me
MYSQL_ROOT_PASSWORD=replace_root_password
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000
# Opaque database sessions are used; JWT secrets are unnecessary.
SESSION_DAYS=7
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TaskFlow <noreply@example.com>
DEMO_EMAIL=demo@taskflow.local
DEMO_PASSWORD=

# Only set this when the API is reachable exclusively through that many trusted proxies.
TRUST_PROXY_HOPS=0
COMPOSE_CLIENT_URL=http://localhost:8080
COMPOSE_NODE_ENV=development
